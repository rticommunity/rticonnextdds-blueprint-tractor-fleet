<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/7.7.0/rti_persistence_service.xsd">

    <!-- Default for direct service launches; the environment overrides it. -->
    <configuration_variables>
        <value>
            <element>
                <name>DOMAIN_TAG</name>
                <value>tractor-fleet-salinas-CA</value>
            </element>
        </value>
    </configuration_variables>

    <persistence_service name="tractorFleetDisk">
        <annotation>
            <documentation>
                Persists fleet topics published with PERSISTENT durability.
            </documentation>
        </annotation>

        <persistent_storage>
            <filesystem>
                <directory>$(STORAGE_DIRECTORY)</directory>
                <file_prefix>tractorFleetDisk_</file_prefix>
            </filesystem>
        </persistent_storage>

        <participant name="tractorFleetPersistenceParticipant">
            <domain_id>0</domain_id>
            <domain_participant_qos>
                <property>
                    <value>
                        <element>
                            <name>dds.domain_participant.domain_tag</name>
                            <value>$(DOMAIN_TAG)</value>
                            <propagate>true</propagate>
                        </element>
                    </value>
                </property>
            </domain_participant_qos>
            <persistence_group name="persistAll">
                <filter>*</filter>
                <single_publisher>true</single_publisher>
                <single_subscriber>true</single_subscriber>
                <datawriter_qos base_name="SystemPersistenceQosLib::QosProfile"/>
                <datareader_qos base_name="SystemPersistenceQosLib::QosProfile"/>
            </persistence_group>
        </participant>
    </persistence_service>

</dds>
